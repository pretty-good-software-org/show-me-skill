#!/usr/bin/env bash
#MISE description="Verify the Claude plugin manifest is generated by APM"
set -euo pipefail

pack_dir="$(mktemp -d "${TMPDIR:-/tmp}/apm-plugin-manifest.XXXXXX")"
trap 'rm -rf "$pack_dir"' EXIT

cp apm.yml "$pack_dir/apm.yml"
cp -R skills "$pack_dir/skills"
mkdir "$pack_dir/.claude-plugin"

(
  cd "$pack_dir"
  apm pack --force >/dev/null
)

cmp -- .claude-plugin/plugin.json "$pack_dir/.claude-plugin/plugin.json"
echo "APM-generated plugin.json matches the committed manifest"
